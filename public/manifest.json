{
  "name": "NexTrack - Smart Offline Accounting",
  "short_name": "NexTrack",
  "description": "Offline-first small business accounting software with inventory, sales orders, purchases, reports, and optional Firebase cloud sync.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#ecfdf5",
  "theme_color": "#065f46",
  "orientation": "portrait",
  "lang": "en-NG",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": ["business", "productivity", "finance"],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "72x72 96x96 128x128 144x144 152x152 192x192 256x256 384x384 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Home",
      "description": "Open NexTrack dashboard overview",
      "url": "/dashboard",
      "icons": [
        { "src": "/icons/icon.svg", "sizes": "192x192", "type": "image/svg+xml" }
      ]
    },
    {
      "name": "New Sale",
      "short_name": "New Sale",
      "description": "Create a new sales order",
      "url": "/sales",
      "icons": [
        { "src": "/icons/icon.svg", "sizes": "192x192", "type": "image/svg+xml" }
      ]
    },
    {
      "name": "New Purchase",
      "short_name": "New Purchase",
      "description": "Record a new purchase order",
      "url": "/purchase",
      "icons": [
        { "src": "/icons/icon.svg", "sizes": "192x192", "type": "image/svg+xml" }
      ]
    }
  ]
}
